{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/radar.js": {
      "maxDuration": 60
    },
    "api/bot.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "radeevich.ru"
        }
      ],
      "destination": "/web",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.radeevich.ru"
        }
      ],
      "destination": "/web",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors * https://web.telegram.org https://desktop.telegram.org https://macos.telegram.org 'self'"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/|^$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}